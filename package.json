{
  "name": "mohamed-portfolio",
  "version": "1.0.0",
  "description": "Source-backed ML engineering portfolio for Mohamed Ehab",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "wrangler pages dev out --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.mjs",
    "preview:cloudflare": "wrangler pages dev out --port 3000",
    "deploy": "npm run build && wrangler pages deploy out --project-name mohamed-ehab-portfolio --branch main"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
